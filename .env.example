# ============================================================================
#  Шаблон переменных окружения для docker-compose.
#  Скопируйте в .env и подставьте свои значения:  cp .env.example .env
#  Файл .env в git НЕ коммитится (см. .gitignore) — там лежат секреты.
# ============================================================================

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=fias
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret          # в проде заменить на стойкий секрет
POSTGRES_PORT=5432                # порт, проброшенный на хост

# --- Fias.Api --------------------------------------------------------------
API_PORT=8080                     # http://localhost:${API_PORT}
ASPNETCORE_ENVIRONMENT=Development

# --- Fias.Service.Updater --------------------------------------------------
# Каталог на хосте, куда updater скачивает/распаковывает выгрузку ГАР.
FIAS_IMPORT_DIR=./fias-import
